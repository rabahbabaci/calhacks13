# Property agent settings. Copy the lines you need into the repo-root .env (never commit .env).
ANTHROPIC_API_KEY_Property=
APIFY_TOKEN_Property=
# Optional: lawsuit search by owner name (free key at courtlistener.com).
COURTLISTENER_TOKEN_Property=
# Optional: higher Socrata rate limits (free app token at dev.socrata.com).
SOCRATA_APP_TOKEN_Property=
# Optional: point the property agent at a different database than the shared STDB_* settings.
# STDB_URL_Property=https://maincloud.spacetimedb.com
# STDB_DB_Property=home
# STDB_TOKEN_Property=
