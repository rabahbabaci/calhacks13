# Plan agent settings. Copy the lines you need into the repo-root .env (never commit .env).
# When a Plan key is unset, the agent uses the matching Property key.
ANTHROPIC_API_KEY_Plan=
APIFY_TOKEN_Plan=
# Optional: point the plan agent at a different database than the shared STDB_* settings.
# STDB_URL_Plan=https://maincloud.spacetimedb.com
# STDB_DB_Plan=home
# STDB_TOKEN_Plan=
