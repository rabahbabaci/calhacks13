# Legal agent settings. Copy the lines you need into the repo-root .env (never commit .env).
ANTHROPIC_API_KEY_Legal=
APIFY_TOKEN_Legal=
# Optional: enables court-opinion search (free key at courtlistener.com).
COURTLISTENER_TOKEN_Legal=
